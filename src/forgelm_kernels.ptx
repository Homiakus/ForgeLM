// forgelm_kernels.ptx - Базовые GPU кернелы для NVIDIA GeForce GTX 1050 Ti (sm_61, compute_61)
.version 6.5
.target sm_61
.address_size 64

// 1. RMSNorm CUDA Kernel
.visible .entry forgelm_gpu_rmsnorm_f32(
    .param .u64 out,
    .param .u64 x,
    .param .u64 w,
    .param .u32 dim,
    .param .f32 eps
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<6>;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [x];
    ld.param.u64 %rd3, [w];
    ld.param.u32 %r1, [dim];

    mov.u32 %r2, %tid.x;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra DONE;

    // Смещение по tid.x * 4
    mul.wide.u32 %rd4, %r2, 4;
    add.u64 %rd5, %rd2, %rd4;
    add.u64 %rd6, %rd3, %rd4;
    add.u64 %rd7, %rd1, %rd4;

    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd6];
    mul.f32 %f3, %f1, %f2;
    st.global.f32 [%rd7], %f3;

DONE:
    ret;
}
